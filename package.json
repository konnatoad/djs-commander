{
  "name": "djs-commander",
  "version": "0.1.5",
  "description": "A command and event handler that works seamlessly with Discord.js",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format cjs,esm --clean",
    "watch": "yarn build --watch src",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/notunderctrl/djs-commander"
  },
  "homepage": "https://djs-commander.underctrl.io",
  "keywords": [
    "discord.js",
    "command",
    "handler",
    "events",
    "validations"
  ],
  "peerDependencies": {
    "discord.js": "^14.0.0",
    "winston": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "winston": {
      "optional": true
    }
  },
  "devDependencies": {
    "discord.js": "^14.26.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "winston": "^3.19.0"
  },
  "resolutions": {
    "esbuild": "0.28.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
