{
  "name": "djs-commander",
  "version": "1.0.1",
  "description": "A command and event handler that works seamlessly with Discord.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format cjs,esm --clean && tsc",
    "watch": "yarn build --watch src",
    "test": "node --test test/",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/konnatoad/djs-commander"
  },
  "homepage": "https://github.com/konnatoad/djs-commander#readme",
  "bugs": "https://github.com/konnatoad/djs-commander/issues",
  "keywords": [
    "discord.js",
    "command",
    "handler",
    "events",
    "validations"
  ],
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "devDependencies": {
    "discord.js": "^14.26.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
